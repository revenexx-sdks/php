{
    "name": "revenexx/sdk",
    "description": "Revenexx PHP SDK.",
    "type": "library",
    "license": "MIT",
    "support": {
        "url": "https://revenexx.com"    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --no-progress"
    },
    "autoload": {
        "psr-4": {
            "Revenexx\\": "src/Revenexx"
        }
    },
    "require": {
        "php": ">=8.0.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "mockery/mockery": "1.6.12",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}